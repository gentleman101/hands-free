# ─────────────────────────────────────────────────────────────────────────────
# Hands-Free environment template
# Copy to .env and adjust per machine.
# ─────────────────────────────────────────────────────────────────────────────

# ── Machine role ─────────────────────────────────────────────────────────────
# "client" = Windows (runs VAD/STT/TTS, calls Mac for LLM)
# "server" = Mac Mini (runs LLM only, exposes HTTP API)
HF_MACHINE_ROLE=client

# ── LLM service location ─────────────────────────────────────────────────────
# Where the Mac LLM server is reachable from the Windows client.
# Use mac-mini.local on the same LAN (mDNS), or static IP on office network.
HF_LLM_SERVICE_URL=http://mac-mini.local:11434
HF_LLM_TIMEOUT_S=10
HF_LLM_MAX_RETRIES=3

# ── LLM model (server side) ──────────────────────────────────────────────────
# Path on Mac to the GGUF model file.
HF_LLM_MODEL_PATH=/Users/naman/models/jais-2-8b-q4.gguf
HF_LLM_MODEL_NAME=jais-2-8b
HF_LLM_PORT=11434
HF_LLM_N_GPU_LAYERS=99
HF_LLM_N_CTX=2048

# ── Generation params ────────────────────────────────────────────────────────
# EXP-007: cap responses at 200 tokens (voice users hate long answers)
HF_MAX_TOKENS=200
HF_LLM_TEMPERATURE=0.7

# ── STT (Windows) ────────────────────────────────────────────────────────────
# Whisper model — large-v3-turbo recommended for bilingual EN/AR
HF_WHISPER_MODEL=large-v3-turbo
HF_WHISPER_DEVICE=cuda
HF_WHISPER_COMPUTE_TYPE=int8

# ── TTS (Windows) ────────────────────────────────────────────────────────────
# Fish Speech sidecar URL
HF_FISH_SPEECH_URL=http://localhost:8001
HF_TTS_ENGINE=fish

# ── VAD ──────────────────────────────────────────────────────────────────────
# "ten" or "silero" (fallback)
HF_VAD_BACKEND=ten
# blank = auto-select (priority: external > built-in)
HF_AUDIO_INPUT_DEVICE=

# ── Pipeline phase (for metrics tagging) ─────────────────────────────────────
HF_PIPELINE_PHASE=raw
