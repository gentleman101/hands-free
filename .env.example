# Hands-Free — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# LLM — Ollama
HF_OLLAMA_BASE_URL=http://localhost:11434/v1
HF_OLLAMA_MODEL=gemma4:e2b

# STT — faster-whisper
HF_WHISPER_MODEL_SIZE=small         # tiny | small | medium | large-v3
# HF_WHISPER_LANGUAGE=ar            # force language: ar | en — leave unset for bilingual auto-detect

# TTS — Fish Speech
HF_FISH_SPEECH_URL=http://localhost:8001
HF_FISH_SPEECH_VOICE_EN=default
HF_FISH_SPEECH_VOICE_AR=default

# Audio
HF_AUDIO_TARGET_PEAK=0.9            # normalize output to this peak level (0.0–1.0, default 0.9)
HF_SAMPLE_RATE_IN=16000
HF_SAMPLE_RATE_OUT=22050
HF_VAD_SILENCE_MS=300               # ms of silence before utterance ends
# HF_AUDIO_INPUT_DEVICE=3           # override mic device index (run: python -c "import sounddevice as sd; print(sd.query_devices())")

# Pipeline
HF_MAX_TOKENS=150
HF_PIPELINE_PHASE=raw               # raw | prompted | lora_v1 | lora_v2 | jais_fallback

# App
HF_ADMIN_PASSWORD=changeme
HF_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
